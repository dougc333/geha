{
  "name": "geha-langgraph-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "server": "tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test server/reviews.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.0.0",
    "zod": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tsx": "^4.0.0",
    "concurrently": "^9.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
