{"schema_version":1,"template":"meridian_shipping_bl_v1","description":"Meridian Shipping ocean bill of lading, one page, eight bordered blocks (bill_of_lading_alt_1 layout). Describes structure and rules only: labels are anchors, patterns validate values. No values from any one document.","page_size_px":[2136,3584],"blocks":[{"block":1,"name":"header","box_px":[67,0,1999,363],"constants":["MERIDIAN SHIPPING","GLOBAL SHIPPING & LOGISTICS","BILL OF LADING"],"fields":[{"name":"bl_number","label":"B/L NO.","label_re":"","pattern":"BL\\d{9}","find":"","type":"string","required":true,"kind":"","line":false},{"name":"scac","label":"SCAC","label_re":"","pattern":"[A-Z]{4}","find":"","type":"string","required":true,"kind":"","line":false}]},{"block":2,"name":"parties","box_px":[67,363,1999,899],"constants":[],"fields":[{"name":"shipper","label":"SHIPPER","label_re":"SHIPPER(?!'S)","pattern":"","find":"","type":"string","required":true,"kind":"party","line":false},{"name":"booking_ref","label":"BOOKING REF.","label_re":"","pattern":"BKG\\d{7}","find":"","type":"string","required":true,"kind":"","line":false},{"name":"shipper_ref","label":"SHIPPER'S REF.","label_re":"","pattern":"[A-Z]{3}-\\d{5}","find":"","type":"string","required":false,"kind":"","line":false},{"name":"pre_carriage_by","label":"PRE-CARRIAGE BY","label_re":"","pattern":"","find":"","type":"string","required":false,"kind":"","line":true},{"name":"consignee","label":"CONSIGNEE","label_re":"CONSIGNEE(\\s*\\(NEGOTIABLE[^)]*\\))?","pattern":"","find":"","type":"string","required":true,"kind":"party","line":false},{"name":"place_of_receipt","label":"PLACE OF RECEIPT","label_re":"","pattern":"","find":"","type":"string","required":false,"kind":"","line":true},{"name":"notify_party","label":"NOTIFY PARTY","label_re":"NOTIFY PARTY(\\s*\\([^)]*\\))?","pattern":"","find":"","type":"string","required":false,"kind":"party","line":false},{"name":"delivery_agent","label":"DELIVERY AGENT","label_re":"","pattern":"","find":"