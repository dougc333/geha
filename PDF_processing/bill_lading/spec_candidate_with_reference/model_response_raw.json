:","label_re":"","pattern":"[A-Z]+ \\(\\d\\)","find":"","type":"string","required":true,"kind":"","line":false}]}],"groups":[{"name":"containers","block":6,"note":"The cargo block is columnar (containers, packages, description, weight, measurement side by side), so each field is collected in reading order and the i-th match of every field belongs to container i.","fields":[{"name":"container_no","find":"\\b([A-Z]{4}\\d{7})\\b","type":"string","check":"iso6346"},{"name":"seal_no","find":"SEAL:\\s*([A-Z]{3}\\d{6})","type":"string","check":""},{"name":"marks","find":"MARKS:\\s*([A-Z]+)","type":"string","check":""},{"name":"packages","find":"(\\d+)\\s+PALLETS\\s+STC","type":"int","check":""},{"name":"commodity","find":"(?m)^\\s*([A-Z][A-Z ]+?)\\s*\\n\\s*STOWAGE AT","type":"string","check":""},{"name":"hs_code","find":"HS CODE:\\s*(\\d{8})","type":"string","check":""},{"name":"set_temp","find":"SET TEMP:\\s*([+-]?\\d+(?:\\.\\d+)?\\s*°C)","type":"string","check":""},{"name":"gross_weight_kg","find":"(\\d{1,3}(?:,\\d{3})+)\\s*KGS","type":"string","check":""},{"name":"measurement_cbm","find":"(\\d+\\.\\d{2})\\s*CBM","type":"string","check":""}]}],"rules":[{"name":"packages_add_up","check":"group_sum_equals","group":"containers","field":"packages","equals":"total_packages","message":"sum of container package counts must equal TOTAL NUMBER OF PACKAGES"},{"name":"original_bls_words_match_digit","check":"words_match_digit","group":"","field":"original_bls","equals":"","message":"number of original B/Ls in words must match the digit, e.g. THREE (3)"},{"name":"date_is_real","check":"valid_date","group":"","field":"date_of_issue","equals":"","message":"DATE OF ISSUE must be a real calendar date"}]}
