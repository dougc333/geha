# Any LiteLLM-compatible model identifier accepted by DSPy.
DSPY_MODEL=openai/gpt-4o-mini

# Set these for an OpenAI-compatible endpoint such as Nous or OpenRouter.
DSPY_API_BASE=
DSPY_API_KEY=

# Existing provider variables are also recognized when DSPY_API_KEY is unset:
# OPENAI_API_KEY, OPENROUTER_API_KEY, or NOUS_KEY.

# Optional compiled DSPy program produced by optimize_router.py.
DSPY_PROGRAM_PATH=

# Optional Langfuse tracing inherited from the original dental graph.
DENTAL_TRACING=0
TRACE_TAGS=dspy,dental-enrollment

# Optional safety guards: Jev input guard, cheaper DSPy guard model
TYPESAFE_API_KEY=
DSPY_GUARD_MODEL=
