FROM node:22-bookworm-slim AS web-build

WORKDIR /build/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN VITE_DEPLOYMENT_MODE=runtime npm run build


FROM python:3.12-slim-bookworm AS app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HF_HOME=/app/model-cache

WORKDIR /app

COPY requirements.runtime.txt ./
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.2,<3" \
    && pip install --no-cache-dir -r requirements.runtime.txt

# Cache only the compact query-embedding model used by the prebuilt vectors.
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('BAAI/bge-small-en-v1.5')"

COPY src/ ./src/
COPY evals/ ./evals/
COPY --from=web-build /build/web/dist ./web/dist

RUN addgroup --system app \
    && adduser --system --uid 10001 --ingroup app app \
    && chown -R app:app /app/model-cache

USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)" || exit 1

CMD ["uvicorn", "aws_data_workflow.runtime_server:app", "--host", "0.0.0.0", "--port", "8000"]
