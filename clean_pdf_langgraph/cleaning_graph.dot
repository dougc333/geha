digraph cleaning_graph {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155", fillcolor="#e0f2fe", margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7];

  start [shape=circle, label="", width=0.22, fixedsize=true, fillcolor="#334155", color="#334155"];
  pdfplumber_extract [label="pdfplumber_extract"];
  docling_extract [label="docling_extract"];
  render_pdf_pages [label="render_pdf_pages"];
  vision_compare [label="vision_compare", fillcolor="#fef3c7"];
  write_errors [label="write_errors", fillcolor="#fee2e2"];
  done [shape=doublecircle, label="END", width=0.55, fixedsize=true, fillcolor="#dcfce7", color="#166534"];

  start -> pdfplumber_extract;
  pdfplumber_extract -> docling_extract;
  docling_extract -> render_pdf_pages;
  render_pdf_pages -> vision_compare;
  vision_compare -> write_errors [label="needs_human_review"];
  vision_compare -> done [label="visually_matched"];
  write_errors -> done;
}
