digraph batch_review_graph {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155", fillcolor="#e0f2fe", margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7];

  start [shape=circle, label="", width=0.22, fixedsize=true, fillcolor="#334155", color="#334155"];
  pdfplumber_extract [label="pdfplumber_extract"];
  docling_extract [label="docling_extract"];
  build_combined_html [label="build_combined_html"];
  render_pdf_pages [label="render_pdf_pages"];
  human_review [label="human_review\n(interrupt)", fillcolor="#fef3c7"];
  vision_compare [label="vision_compare", fillcolor="#ede9fe"];
  vision_declined [label="vision_declined", fillcolor="#fee2e2"];
  write_extractor_reports [label="write_extractor_reports", fillcolor="#dcfce7"];
  done [shape=doublecircle, label="END", width=0.55, fixedsize=true, fillcolor="#dcfce7", color="#166534"];

  start -> pdfplumber_extract;
  pdfplumber_extract -> docling_extract;
  docling_extract -> build_combined_html;
  build_combined_html -> render_pdf_pages;
  render_pdf_pages -> human_review;
  human_review -> vision_compare [label="approved"];
  human_review -> vision_declined [label="declined"];
  vision_compare -> write_extractor_reports;
  vision_declined -> write_extractor_reports;
  write_extractor_reports -> done;
}
