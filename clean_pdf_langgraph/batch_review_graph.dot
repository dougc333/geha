digraph batch_review_graph {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155", fillcolor="#e0f2fe", margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#475569", arrowsize=0.7];

  start [shape=circle, label="", width=0.22, fixedsize=true, fillcolor="#334155", color="#334155"];
  docling_extract [label="docling_extract"];
  build_combined_html [label="build_combined_html"];
  render_pdf_pages [label="render_pdf_pages"];
  cycle_html_tables [label="cycle_html_tables"];
  human_review [label="human_review\n(interrupt)", fillcolor="#fef3c7"];
  initialize_review [label="initialize_review"];
  prepare_table [label="prepare_table"];
  render_html_candidate [label="render_html_candidate"];
  compare_html_candidate [label="compare_html_candidate", fillcolor="#ede9fe"];
  correct_html_candidate [label="correct_html_candidate", fillcolor="#ffedd5"];
  finalize_table [label="finalize_table"];
  finish_review [label="finish_review"];
  corrected_slideshow [label="corrected_slideshow"];
  vision_declined [label="vision_declined", fillcolor="#fee2e2"];
  write_extractor_reports [label="write_extractor_reports", fillcolor="#dcfce7"];
  done [shape=doublecircle, label="END", width=0.55, fixedsize=true, fillcolor="#dcfce7", color="#166534"];

  start -> docling_extract;
  docling_extract -> build_combined_html;
  build_combined_html -> render_pdf_pages;
  render_pdf_pages -> cycle_html_tables;
  cycle_html_tables -> human_review;
  human_review -> initialize_review [label="approved"];
  human_review -> vision_declined [label="declined"];
  initialize_review -> prepare_table [label="table available"];
  initialize_review -> finish_review [label="no tables"];
  prepare_table -> render_html_candidate;
  render_html_candidate -> compare_html_candidate;
  compare_html_candidate -> correct_html_candidate [label="mismatch + budget"];
  correct_html_candidate -> render_html_candidate [label="corrected"];
  compare_html_candidate -> finalize_table [label="done / limit"];
  correct_html_candidate -> finalize_table [label="failure"];
  finalize_table -> prepare_table [label="next table"];
  finalize_table -> finish_review [label="all tables"];
  finish_review -> corrected_slideshow;
  corrected_slideshow -> write_extractor_reports;
  vision_declined -> write_extractor_reports;
  write_extractor_reports -> done;
}
